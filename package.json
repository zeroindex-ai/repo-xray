{
  "name": "repo-xray",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "tsx --env-file=.env.local scripts/migrate-prod.ts",
    "export-reports": "tsx --env-file=.env.local scripts/export-reports.ts",
    "eval": "tsx evals/run.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@libsql/client": "^0.17.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "^8.10.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@zeroindex-ai/eval-pack": "^0.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.15": ">=8.5.15",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  }
}
